# --- Server ---
PORT=4000
# Where the Vite app is served; OAuth callbacks redirect back here.
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string

# --- Infra (matches docker-compose.yml) ---
DATABASE_URL=postgres://reachinbox:reachinbox@localhost:5433/reachinbox
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Goes through the Vite proxy so the session cookie lands on the frontend origin.
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# --- Slack OAuth (https://api.slack.com/apps, scope: incoming-webhook) ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Slack requires HTTPS: expose the backend with a tunnel (ngrok / cloudflared).
SLACK_REDIRECT_URI=https://your-tunnel.example.com/api/slack/oauth/callback

# --- Worker / throughput ---
WORKER_CONCURRENCY=5
# Minimum gap between two sends from the same sender (provider throttling).
MIN_DELAY_BETWEEN_SENDS_MS=2000
# Default per-sender hourly cap; a campaign's own "Hourly Limit" can only lower it.
MAX_EMAILS_PER_HOUR_PER_SENDER=200
# SMTP retry attempts before an email is marked failed.
SEND_MAX_ATTEMPTS=3

# --- Bull Board (optional basic auth for /admin/queues) ---
BULL_BOARD_USER=
BULL_BOARD_PASS=
